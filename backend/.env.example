# Congress.gov API Configuration
# Get your API key from: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=your_congress_api_key_here

# Server Configuration
PORT=3000
# Bind address - 127.0.0.1 accepts connections from this host only, which
# is all the Apache reverse proxy needs; 0.0.0.0 publishes on every
# interface. This file overrides the shell environment, so change the bind
# here rather than exporting HOST=... before starting the server.
HOST=127.0.0.1

# Cache Configuration (in seconds)
CACHE_TTL=3600

# API Authentication (optional - for restricting access to your proxy)
# Generate a secure random string for production
API_AUTH_TOKEN=your_secure_auth_token_here

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100