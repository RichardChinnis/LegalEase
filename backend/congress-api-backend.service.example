# systemd unit example for the Node.js backend.
#
# Copy to /etc/systemd/system/congress-api-backend.service (or symlink it),
# edit User/Group/WorkingDirectory for your deployment, then:
#   systemctl daemon-reload
#   systemctl enable --now congress-api-backend

[Unit]
Description=Congress API Backend Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=nodeapp
Group=nodeapp
WorkingDirectory=/path/to/congress-api/backend
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
